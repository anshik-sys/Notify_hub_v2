# Web app: RLS-restricted role. Must NOT be a superuser or the table owner.
DATABASE_URL=postgres://notifyhub_app:dev@localhost:5432/notifyhub
# Migrations and worker: table owner (bypasses RLS).
OWNER_DATABASE_URL=postgres://localhost:5432/notifyhub
# Better Auth: its own tables + company creation. Role notifyhub_auth.
AUTH_DATABASE_URL=postgres://notifyhub_auth:dev@localhost:5432/notifyhub
BETTER_AUTH_SECRET=dev-only-change-me-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000
# Optional. Google sign-in is off unless both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev: Mailpit. Prod: SES SMTP endpoint, see DEPLOYMENT.md.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="NotifyHub <notifications@notifyhub.app>"
# AES-256-GCM key for integration secrets (Slack tokens): openssl rand -base64 32.
# Required: processes that handle tokens refuse to start without it.
ENCRYPTION_KEY=
# Slack app (see DEPLOYMENT.md). Dev against the fake (pnpm fake-slack):
SLACK_CLIENT_ID=fake
SLACK_CLIENT_SECRET=fake
SLACK_SIGNING_SECRET=fake-signing-secret
# Dev only; leave unset in production (defaults to slack.com).
SLACK_API_URL=http://localhost:4999/api
SLACK_AUTHORIZE_URL=http://localhost:4999/oauth/v2/authorize
